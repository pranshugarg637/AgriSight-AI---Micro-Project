{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgriSight curated help centres (one file per state)",
  "description": "Only data copied from an official directory. Every entry needs source_url and verified_on or it is rejected by the loader.",
  "type": "object",
  "required": ["state", "centers"],
  "properties": {
    "state": { "type": "string", "description": "State name as shown to users, e.g. \"Uttar Pradesh\"" },
    "centers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "source_url", "verified_on"],
        "properties": {
          "name": { "type": "string" },
          "name_local": { "type": "string", "description": "Name in the local language (optional)" },
          "type": { "enum": ["kvk", "agriculture_office", "helpline", "other"] },
          "district": { "type": "string", "description": "Required unless type = helpline" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "source_url": { "type": "string", "description": "Official page the entry was copied from" },
          "verified_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
