{
  "name": "plant-disease-backend",
  "version": "1.0.0",
  "description": "Node/Express backend for the Evidence-Grounded Plant Disease Decision Support System. Proxies requests to the Python ML/RAG service; contains no ML logic itself.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "retention": "node src/db/retention.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "form-data": "^4.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "node-mocks-http": "^1.18.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
