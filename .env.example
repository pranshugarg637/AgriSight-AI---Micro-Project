# =====================================================================
# AgriSight AI v2 -- environment configuration
# Copy to `.env` in the project root and adjust. Never commit `.env`.
# Both the Node backend and the Python ML service read this file.
# =====================================================================

# --- Environment -------------------------------------------------------
# development | test | production. In production the services refuse to
# start without strong secrets (JWT_SECRET, ML_INTERNAL_TOKEN).
ENV=development

# --- Paths (relative to project root) -----------------------------------
MODEL_PATH=./models/plant_disease_model.pt
MODEL_CONFIG_PATH=./models/model_config.json
CLASS_NAMES_PATH=./models/class_names.json
DATASET_PATH=./data/plantvillage
VECTOR_DB_PATH=./data/vector_db
KNOWLEDGE_BASE_PATH=./knowledge_base/documents
PREDICTIONS_LOG_PATH=./data/predictions_log.jsonl

# --- Confidence thresholds (applied to CALIBRATED probabilities) --------
HIGH_CONFIDENCE_THRESHOLD=0.80
LOW_CONFIDENCE_THRESHOLD=0.60

# --- Differential diagnosis --------------------------------------------
MAX_DIFFERENTIAL_ALTERNATIVES=2
DIFFERENTIAL_MIN_SHARE=0.10

# --- RAG ---------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.35
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Languages & translation (Step 2) -----------------------------------
# App languages. Adding one = frontend/src/i18n/locales/<code>.json +
# audio_scripts/<code>/ + add the code here.
SUPPORTED_LANGUAGES=en,hi
# indictrans2 | bhashini | none. The English explanation is always the source
# of truth; the backend only translates it (llama3.2 never writes Hindi).
TRANSLATION_BACKEND=indictrans2
TRANSLATION_DEVICE=cpu
INDICTRANS2_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS2_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Diagnosis quality (Step 5) ------------------------------------------
# Temperature + OOD thresholds are NOT env vars: they are fitted by
# `python -m app.calibration.fit` and stored in models/model_config.json.
QUESTIONS_PATH=./knowledge_base/questions
REFINE_MARGIN=0.30
RAG_RETRIEVAL_MODE=hybrid
RAG_HYBRID_ALPHA=0.6
RAG_RERANKER=none
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FAITHFULNESS_BACKEND=nli
FAITHFULNESS_MODEL=cross-encoder/nli-deberta-v3-small
FAITHFULNESS_MIN_ENTAILMENT=0.5
FAITHFULNESS_ACTION=remove

# --- LLM (Ollama, runs separately) --------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# --- Image validation ----------------------------------------------------
MAX_IMAGE_SIZE_MB=8
MIN_IMAGE_DIMENSION=64
BLUR_VARIANCE_THRESHOLD=25

# --- Training -------------------------------------------------------------
IMAGE_SIZE=224
BATCH_SIZE=32
NUM_EPOCHS=15
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=4
VAL_SPLIT=0.15
TEST_SPLIT=0.15
BACKBONE=mobilenet_v2
MODEL_VERSION=1.0.0

# --- ML service (FastAPI) -------------------------------------------------
ML_SERVICE_PORT=8000
# Shared secret between backend and ML service. The ML service rejects every
# /api request without it. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_INTERNAL_TOKEN=change-me-dev-internal-token-0123456789

# --- Backend (Node/Express) -----------------------------------------------
BACKEND_PORT=5000
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ML_REQUEST_TIMEOUT_MS=180000
# Express "trust proxy" (for correct per-IP rate limits behind a proxy)
TRUST_PROXY=loopback

# --- Database ---------------------------------------------------------------
# Dev: SQLite file. Compose/production: DB_CLIENT=pg + DATABASE_URL.
DB_CLIENT=better-sqlite3
DB_FILENAME=backend/data/agrisight.sqlite3
DATABASE_URL=

# --- Auth (JWT) ---------------------------------------------------------------
# REQUIRED in production (>= 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-dev-jwt-secret-0123456789-abcdefghijklmnop
JWT_ISSUER=agrisight
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=agrisight_rt
# Secure cookies work on http://localhost in Chrome/Firefox. Set false only if
# your browser refuses to store the cookie during local development.
COOKIE_SECURE=true
BCRYPT_COST=12
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Rate limits (per IP) -----------------------------------------------------
PREDICT_RATE_LIMIT_PER_MIN=20
FARMER_PREDICT_RATE_LIMIT_PER_MIN=6
FARMER_RATE_LIMIT_PER_MIN=60
FARMER_MAX_IMAGE_SIZE_MB=4

# --- Nearby help finder (Step 4) -------------------------------------------
# overpass (OpenStreetMap, no key) | google (needs GOOGLE_PLACES_API_KEY)
SHOP_PROVIDER=overpass
OVERPASS_URL=https://overpass-api.de/api/interpreter
SHOP_SEARCH_RADIUS_M=15000
SHOP_MAX_RESULTS=10
SHOP_CACHE_TTL_SECONDS=86400
SHOP_PROVIDER_TIMEOUT_MS=15000
# OSM policies require an identifying User-Agent with contact details
PROVIDER_USER_AGENT=AgriSightAI/2.0 (college project; contact: you@example.com)
GOOGLE_PLACES_API_KEY=
HELP_CENTERS_DIR=data/help_centers

# --- Account Mode storage & weather risk (Step 6) --------------------------
IMAGE_STORE_DIR=backend/data/images
IMAGE_RETENTION_DAYS=180
STORE_FARMER_IMAGES=false
WEATHER_PROVIDER=open-meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=10800
WEATHER_TIMEOUT_MS=15000
RISK_RULES_DIR=knowledge_base/risk_rules

# --- Demo seed (npm run seed, dev only) ----------------------------------------
# SEED_DEMO_PASSWORD=
# SEED_USER_EMAIL=demo-user@agrisight.local
# SEED_EXPERT_EMAIL=demo-expert@agrisight.local
# SEED_ADMIN_EMAIL=demo-admin@agrisight.local

# --- Frontend (React/Vite) -------------------------------------------------------
VITE_BACKEND_URL=http://localhost:5000
